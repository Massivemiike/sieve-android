<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 6-11 (android:fullBackupContent); Android 12+ reads
     data_extraction_rules.xml instead. Keep the two files identical.

     Nothing Sieve keeps in its own storage is worth uploading, and some of it is secret:
       - cookies.txt          the user's imported login-session cookies
       - sieve.preferences_pb DataStore: the proxy (may be "user:pass@host"), user-agent, speed limit,
                              and a Storage Access Framework grant that means nothing on another phone
       - sieve.db             the queue; each row's engine args carry the proxy (with its credentials) and the cookies path
       - work/, output/       half-downloaded and finished media (far over the 25 MB backup cap)
       - external updates/    the self-update APK (getExternalFilesDir(null)/updates, tens of MB). Not secret, but Auto
                              Backup includes the "external" domain by default and one file over the 25 MB quota
                              makes the whole app backup be skipped
       - youtubedl-android.xml  the library's own prefs (shared_prefs/): its record of which yt-dlp it downloaded
                              (dlpVersion), plus its Python and ffmpeg versions. The engine files themselves live in
                              noBackupFilesDir and are never backed up, so a restored record names a yt-dlp that is not
                              there: the bundled (older) one runs while every version check and the updater read "current"
                              (Dailymotion "No video formats found!", Vimeo "HTTP Error 401"). Keep the record and the
                              files together: both come back or neither does.
     (The Python runtime, ffmpeg and yt-dlp live in noBackupFilesDir and are never backed up.) -->
<full-backup-content>
    <exclude domain="file" path="cookies.txt" />
    <exclude domain="file" path="cookies.txt.tmp" />
    <exclude domain="file" path="sieve.preferences_pb" />
    <exclude domain="file" path="sieve.preferences_pb.tmp" />
    <exclude domain="file" path="work" />
    <exclude domain="file" path="output" />
    <exclude domain="database" path="sieve.db" />
    <exclude domain="database" path="sieve.db-wal" />
    <exclude domain="database" path="sieve.db-shm" />
    <exclude domain="database" path="sieve.db-journal" />
    <exclude domain="external" path="updates" />
    <exclude domain="sharedpref" path="youtubedl-android.xml" />
</full-backup-content>
