# Copy to app/keystore.properties (git-ignored) and fill in for signed release builds.
# The keystore itself lives OUTSIDE the repo and is backed up securely — losing it
# breaks all future in-app self-updates (a changed signing key is rejected).
storeFile=/absolute/path/to/sieve-release.jks
storePassword=CHANGE_ME
keyAlias=sieve
keyPassword=CHANGE_ME
